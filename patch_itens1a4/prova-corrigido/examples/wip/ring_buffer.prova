;; ============================================================================
;; Ring Buffer SPSC (Single-Producer Single-Consumer) Lock-Free
;; Exercita: (atomic u32), isenção linear, order specifiers (relaxed/acq-rel),
;;           aritmética +wrap, tipos de refinamento em slice e emissão !volatile.
;; ============================================================================

;; Região compartilhada para dados de baixa latência (ex: driver NIC / áudio)
(region shared-ring
  (size 256)
  (volatile true))

;; Tenta inserir um valor u32 na fila (lado do Produtor).
;; Retorna 1 em caso de sucesso, ou 0 se o buffer estiver cheio.
;; Nota: head e tail são (atomic u32) — eximidos da checagem de posse linear,
;; permitindo compartilhamento seguro entre produtor e consumidor.
(fn ring-push
  (params (buf  (slice u32 64 :region shared-ring))
          (head (atomic u32))
          (tail (atomic u32))
          (val  u32))
  (returns u32)
  ;; Contrato: capacidade fixa em potência de 2 (64 = 2^6) para máscara rápida
  (pre (= (len buf) 64))
  (post (or (= result 0) (= result 1)))
  (effects shared-ring)
  (body
    ;; 1. O produtor lê seu próprio índice 'tail' com ordenação relaxed
    (let ((curr-tail (atomic-load tail :order relaxed)))
      ;; 2. Lê 'head' (atualizado pelo consumidor) com barreira acq-rel
      (let ((curr-head (atomic-load head :order acq-rel)))
        ;; Calcula próximo índice com wrap explícito (sem UB de overflow)
        (let ((next-tail (+wrap curr-tail 1)))
          ;; Verifica se a fila está cheia: (tail - head) >= 64
          (let ((used (-wrap curr-tail curr-head)))
            (if (>= used 64)
              ;; Buffer cheio: retorna 0 sem modificar memória
              0
              ;; Há espaço livre: calcula o índice físico via máscara (0..63)
              ;; O Z3 prova: (bit-and curr-tail 63) < 64 -> acesso seguro sem bounds check!
              (let ((slot (bit-and curr-tail 63)))
                (begin
                  ;; Escreve o dado na região volátil antes de publicar o novo tail
                  (slice-set buf slot val)
                  ;; Publica o novo tail com barreira acq-rel (garante visibilidade do dado)
                  (atomic-store tail next-tail :order acq-rel)
                  1)))))))))

;; Tenta remover um valor u32 da fila (lado do Consumidor).
;; Retorna o valor lido se houver dado, ou 0 se estiver vazio (e escreve status em out-ok).
(fn ring-pop
  (params (buf    (slice u32 64 :region shared-ring))
          (head   (atomic u32))
          (tail   (atomic u32))
          (out-ok (mut (slice u32 1))))
  (returns u32)
  (pre (and (= (len buf) 64) (= (len out-ok) 1)))
  (effects shared-ring)
  (body
    ;; 1. O consumidor lê seu próprio índice 'head' com ordenação relaxed
    (let ((curr-head (atomic-load head :order relaxed)))
      ;; 2. Lê 'tail' (publicado pelo produtor) com barreira acq-rel
      (let ((curr-tail (atomic-load tail :order acq-rel)))
        ;; Se head == tail, a fila está vazia
        (if (= curr-head curr-tail)
          (begin
            (slice-set out-ok 0 0)
            0)
          ;; Há elementos disponíveis: calcula slot físico (0..63)
          ;; O Z3 prova: (bit-and curr-head 63) < 64
          (let ((slot (bit-and curr-head 63)))
            (let ((item (slice-get buf slot)))
              (let ((next-head (+wrap curr-head 1)))
                (begin
                  ;; Avança head com barreira acq-rel liberando o slot para o produtor
                  (atomic-store head next-head :order acq-rel)
                  (slice-set out-ok 0 1)
                  item)))))))))

;; Função de teste de integração executando um ciclo push -> pop
(fn test-ring-cycle
  (params (buf    (slice u32 64 :region shared-ring))
          (head   (atomic u32))
          (tail   (atomic u32))
          (status (mut (slice u32 1))))
  (returns u32)
  (pre (and (= (len buf) 64) (= (len status) 1)))
  (effects shared-ring)
  (body
    (let ((pushed (ring-push buf head tail 42)))
      (if (= pushed 1)
        (ring-pop buf head tail status)
        0))))