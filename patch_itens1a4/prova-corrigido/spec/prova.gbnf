# Gramática GBNF (llama.cpp / llguidance) para constrained decoding: a IA só emite tokens válidos.
root     ::= ws (data | fn)+
data     ::= "(" ws "data" ws ident ws string ws ")" ws
fn       ::= "(" ws "fn" ws ident ws params ws returns ws pre ws post ws body ws ")" ws
params   ::= "(" ws "params" (ws param)* ws ")"
param    ::= "(" ws ident ws ptype ws ")"
ptype    ::= scalar | slice | "(" ws "own" ws slice ws ")"
slice    ::= "(" ws "slice" ws "u8" ws ident ws ")"
scalar   ::= "i64" | "usize" | "u8"
returns  ::= "(" ws "returns" ws (scalar | "unit") ws ")"
pre      ::= "(" ws "pre" (ws expr)* ws ")"
post     ::= "(" ws "post" (ws expr)* ws ")"
body     ::= "(" ws "body" (ws stmt)* ws ")"
stmt     ::= "(" ws ( "let" ws ident ws scalar ws expr
                    | "var" ws ident ws scalar ws expr
                    | "set" ws ident ws expr
                    | "let_slice" ws ident ws "(" ws "data-ref" ws ident ws ")"
                    | "store" ws ident ws expr ws expr
                    | "assert" ws expr
                    | "do" ws expr
                    | "drop" ws ident
                    | "return" (ws expr)?
                    | "sys_exit" ws expr
                    | "if" ws expr (ws block)+
                    | "while" ws expr ws inv ws dec (ws stmt)* ) ws ")"
block    ::= "(" ws ("then" | "else") (ws stmt)* ws ")"
inv      ::= "(" ws "invariant" (ws expr)* ws ")"
dec      ::= "(" ws "decreases" ws expr ws ")"
expr     ::= int | ident | "(" ws op (ws expr)+ ws ")"
           | "(" ws "cast" ws scalar ws expr ws ")"
           | "(" ws "len" ws ident ws ")"
           | "(" ws "load" ws ident ws expr ws ")"
           | "(" ws "sys_write" ws expr ws ident ws expr ws ")"
           | "(" ws "call" ws ident (ws expr)* ws ")"
op       ::= "+" | "-" | "*" | "<=" | ">=" | "<" | ">" | "=" | "!=" | "and" | "or" | "not"
ident    ::= [a-z_] [a-z0-9_]*
int      ::= "-"? [0-9]+
string   ::= "\"" [^"]* "\""
ws       ::= ([ \t\n] | ";;" [^\n]* "\n")*
