new file mode 100644
index 0000000..48c0cfe
--- /dev/null
+++ b/tests/test_boot.py
@@ -0,0 +1,102 @@
+"""Boot bare-metal: arquivos em boot/ não derivam do gerador; estrutura por arquitetura; e, no x86-64
+Linux com `as`/`ld`, o stub é MONTADO, LIGADO e EXECUTADO (pilha alinhada e na região, .bss zerado)."""
+import os, platform, shutil, subprocess, sys, tempfile, unittest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+from provac.boot import BASE, TARGETS, boot_asm, linker_script  # noqa: E402
+
+KMAIN_SCAFFOLD = """\
+        .text
+        .globl kmain
+kmain:                                   # andaime de teste; o kmain real vem do Prova
+        mov     %rsp, %rax
+        add     $8, %rax
+        test    $15, %rax
+        jnz     bad                      # pilha desalinhada antes do call
+        lea     __stack_bottom(%rip), %rcx
+        cmp     %rcx, %rsp
+        jb      bad
+        lea     __stack_top(%rip), %rcx
+        cmp     %rcx, %rsp
+        ja      bad
+        cmpq    $0, probe(%rip)          # .bss precisa estar zerado
+        jne     bad
+        movq    $1, probe(%rip)          # e gravável
+        xor     %edi, %edi
+        jmp     done
+bad:    mov     $1, %edi
+done:   mov     $60, %eax
+        syscall
+        .bss
+        .globl probe
+probe:  .quad 0
+"""
+
+
+def read(path):
+    return open(os.path.join(ROOT, path), encoding="utf-8").read()
+
+
+def test_checked_in_boot_files_match_the_generator():
+    for t in TARGETS:
+        assert read(f"boot/boot-{t}.S") == boot_asm(t), f"boot/boot-{t}.S diverge do gerador (rode prova.py boot)"
+        assert read(f"boot/linker-{t}.ld") == linker_script(t), f"boot/linker-{t}.ld diverge do gerador"
+
+
+def test_stub_structure_per_architecture():
+    marks = {"x86_64": ("call    kmain", "hlt", "rep stosb"),
+             "aarch64": ("bl      kmain", "wfe", "CPACR_EL1"),
+             "riscv64": ("call    kmain", "wfi", "bgeu")}
+    for t, needed in marks.items():
+        text = boot_asm(t)
+        for sym in ("_boot", "__stack_top", "__bss_start", "__bss_end"):
+            assert sym in text, (t, sym)
+        for m in needed:
+            assert m in text, (t, m)
+    assert "call    meu_main" in boot_asm("x86_64", entry="meu_main")
+
+
+def test_invalid_names_are_rejected():
+    for bad in ("Kmain", "k main", "1k", "k;rm"):
+        try:
+            boot_asm("x86_64", entry=bad)
+        except ValueError:
+            continue
+        raise AssertionError(f"entry inválido aceito: {bad!r}")
+    try:
+        boot_asm("mips")
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("alvo desconhecido aceito")
+
+
+def test_linker_script_layout():
+    for t in TARGETS:
+        ld = linker_script(t)
+        assert "ENTRY(_boot)" in ld and hex(BASE[t]) in ld
+        assert ld.index("__bss_start") < ld.index("__bss_end") < ld.index("__stack_bottom") < ld.index("__stack_top")
+    assert "0x80200000" in linker_script("riscv64", base=0x80200000)  # com OpenSBI
+
+
+def test_x86_64_stub_assembles_links_and_runs():
+    if not (sys.platform.startswith("linux") and platform.machine() in ("x86_64", "AMD64")):
+        raise unittest.SkipTest("precisa de Linux x86-64")
+    if not (shutil.which("as") and shutil.which("ld")):
+        raise unittest.SkipTest("precisa de `as` e `ld` (binutils)")
+    with tempfile.TemporaryDirectory() as d:
+        def w(name, text):
+            p = os.path.join(d, name)
+            open(p, "w", encoding="utf-8").write(text)
+            return p
+        boot, km, ld = w("boot.S", boot_asm("x86_64")), w("kmain.S", KMAIN_SCAFFOLD), w("k.ld", linker_script("x86_64"))
+        for src, obj in ((boot, "boot.o"), (km, "kmain.o")):
+            r = subprocess.run(["as", src, "-o", os.path.join(d, obj)], capture_output=True, text=True)
+            assert r.returncode == 0, r.stderr
+        exe = os.path.join(d, "kern")
+        r = subprocess.run(["ld", "-T", ld, "-nostdlib", "-o", exe, os.path.join(d, "boot.o"), os.path.join(d, "kmain.o")],
+                           capture_output=True, text=True)
+        assert r.returncode == 0, r.stderr
+        r = subprocess.run([exe])
+        assert r.returncode == 0, f"stub de boot falhou (1 = pilha/alinhamento/.bss): código {r.returncode}"
diff --git a/tests/test_checker.py b/tests/test_checker.py
new file mode 100644
index 0000000..e8f07bb
--- /dev/null
+++ b/tests/test_checker.py
@@ -0,0 +1,113 @@
+"""Verificador: exemplos bons são TOTALMENTE provados; exemplos ruins são recusados pelo motivo certo;
+regressões de solidez/robustez (achadas na revisão de 13/nov/2026) ficam travadas."""
+import os, subprocess, sys, tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+import prova  # noqa: E402
+from provac.check import ProvaError  # noqa: E402
+from provac.sexp import ParseError  # noqa: E402
+
+EX = os.path.join(ROOT, "examples")
+GOOD = ["sum_to", "copy_bytes", "hello", "ok_own", "calls",
+        "x86_64_start", "aarch64_start", "riscv64_start", "kmain_min",
+        "effects", "regions_flow", "stack_budget", "atomic_counter", "driver_demo"]
+
+
+def results(name):
+    return prova.analyse(os.path.join(EX, name + ".prova"))[2]
+
+
+def failed(res):
+    return [o["label"] for r in res for o in r["obligations"] if o["status"] == "failed"]
+
+
+def policy(res):
+    return [e for r in res for e in r.get("policy_errors", [])]
+
+
+def linear(res):
+    return [e for r in res for e in r["linear_errors"]]
+
+
+def src_error(src):
+    """Devolve a mensagem de erro (ProvaError/ParseError) ou None se aceitou."""
+    with tempfile.NamedTemporaryFile("w", suffix=".prova", delete=False, encoding="utf-8") as f:
+        f.write(src)
+    try:
+        _, _, res = prova.analyse(f.name)
+    except (ProvaError, ParseError) as e:
+        return str(e)
+    bad = failed(res) or linear(res)
+    return "\n".join(map(str, bad)) if bad else None
+
+
+def test_good_examples_are_fully_proved():
+    for name in GOOD:
+        res = results(name)
+        assert not failed(res) and not linear(res), name
+        pending = [o["label"] for r in res for o in r["obligations"] if o["status"] != "proved"]
+        assert not pending, f"{name}: obrigações só testadas/incertas: {pending}"
+
+
+def test_bad_examples_are_rejected_for_the_right_reason():
+    assert any("overflow" in l for l in failed(results("bad_inc")))
+    assert any("limites" in l for l in failed(results("bad_bounds")))
+    assert any("vazamento" in e for e in linear(results("bad_leak")))
+    assert any("chamada clamp: pre" in l for l in failed(results("bad_call_pre")))
+    assert any("len(buf) = n" in l for l in failed(results("bad_call_len")))
+    assert any("após drop ou movimento" in e for e in linear(results("bad_move")))
+    try:
+        results("bad_recursion")
+    except ProvaError as e:
+        assert "recursão" in str(e)
+    else:
+        raise AssertionError("recursão deveria ser recusada")
+
+
+def test_new_bad_examples_are_rejected():
+    assert any("efeito 'syscall' não declarado" in e for e in policy(results("bad_effect")))
+    assert any("fluxo proibido net-rx → @write" in e for e in policy(results("bad_flow")))
+    assert any(l.startswith("pilha: mid") for l in failed(results("bad_stack")))
+    assert any("pré-condição contraditória" in e for e in policy(results("bad_pre")))
+    try:
+        results("bad_atomic_order")
+    except ProvaError as e:
+        assert "ilegal em atomic_load" in str(e)
+    else:
+        raise AssertionError("ordem atômica ilegal deveria ser recusada")
+
+
+def test_strict_types_and_contracts():
+    assert "incompatíveis" in src_error("(fn f (params (a i64) (b usize)) (returns i64) (pre) (post) (body (return (+ a b))))")
+    assert "terminação" in src_error("(fn f (params (n usize)) (returns unit) (pre) (post) (body (while (< 0 n) (invariant))))")
+    assert "(pre" in src_error("(fn f (params) (returns unit) (body))")
+    assert "mutável" in src_error("(fn f (params (n usize)) (returns unit) (pre) (post) (body (set n 1)))")
+
+
+def test_soundness_regressions():
+    callee = "(fn g (params (x usize)) (returns usize) (pre) (post (<= 0 result)) (body (return x)))\n"
+    assert "argumento cabe em usize" in src_error(callee + "(fn f (params) (returns usize) (pre) (post) (body (return (call g -1))))")
+    assert "argumento cabe em u8" in src_error(
+        "(fn g (params (x u8)) (returns unit) (pre) (post) (body (return)))\n(fn f (params) (returns unit) (pre) (post) (body (do (call g 300))))")
+    assert "fd de sys_write deve ser i64" in src_error(
+        '(data m "a")\n(fn f (params (fd usize)) (returns unit) (pre) (post) (body (let_slice b (data-ref m)) (do (sys_write fd b 1))))')
+    assert "argumento cabe em i64" in src_error(
+        "(fn f (params) (returns unit) (pre) (post) (body (sys_exit 99999999999999999999)))")
+    assert "and exige operandos booleanos" in src_error("(fn f (params (x i64) (y i64)) (returns unit) (pre (and x y)) (post) (body))")
+
+
+def test_robustness_errors_are_structured():
+    # antes: KeyError/IndexError/TypeError vazavam como traceback
+    assert "não está definida em todos os caminhos" in src_error(
+        '(data m "abc")\n(fn f (params (c i64)) (returns unit) (pre) (post) (body (if (< c 0) (then (let_slice b (data-ref m)))) (store b 0 1)))')
+    assert "malformada" in src_error("(fn f (params (x)) (returns unit) (pre) (post) (body))")
+    assert "tipo inválido" in src_error("(fn f (params) (returns unit) (pre) (post) (body (let x i8 0)))")  # i8 não existe
+    assert "forma de topo inválida" in src_error("foo")
+
+
+def test_report_summary_is_never_negative():
+    out = subprocess.run([sys.executable, os.path.join(ROOT, "prova.py"), "check", os.path.join(EX, "bad_leak.prova")],
+                         capture_output=True, text=True, encoding="utf-8").stdout
+    assert "resumo:" in out and "-1" not in out, out
+    assert "1 erros de posse" in out
