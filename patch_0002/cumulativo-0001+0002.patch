new file mode 100644
index 0000000..23dc303
--- /dev/null
+++ b/tests/_util.py
@@ -0,0 +1,41 @@
+"""Utilidades compartilhadas pelos testes."""
+import os, sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+import prova  # noqa: E402
+from provac.check import ProvaError  # noqa: E402
+from provac.sexp import ParseError  # noqa: E402
+
+EX = os.path.join(ROOT, "examples")
+
+
+def example(name):
+    return open(os.path.join(EX, name + ".prova"), encoding="utf-8").read()
+
+
+def build(src, frames=None):
+    return prova.build_checked(src, frames)
+
+
+def problems(P):
+    """Tudo que reprova o programa: obrigações que falharam + erros de posse/política."""
+    out = []
+    for r in P.results:
+        out += r["linear_errors"] + r.get("policy_errors", [])
+        out += [o["label"] for o in r["obligations"] if o["status"] == "failed"]
+    return out
+
+
+def pending(P):
+    return [o["label"] for r in P.results for o in r["obligations"] if o["status"] != "proved"]
+
+
+def src_error(src):
+    """Mensagem de erro (ProvaError/ParseError ou problemas de verificação) ou None se aceitou limpo."""
+    try:
+        P = build(src)
+    except (ProvaError, ParseError) as e:
+        return str(e)
+    ps = problems(P)
+    return "\n".join(ps) if ps else None
diff --git a/tests/fake_model.py b/tests/fake_model.py
new file mode 100644
index 0000000..c23679e
--- /dev/null
+++ b/tests/fake_model.py
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+"""'Modelo' determinístico para testar o laço de correção (nenhuma IA real aqui).
+Uso: fake_model.py MODO   (lê o JSON do laço no stdin, imprime o fonte .prova completo)
+  honest   : corrige o laço de bad_bounds.
+  cheater  : na 1ª iteração tenta 'corrigir' tornando a pre contraditória (prova tudo!); depois fica honesto.
+  garbage  : na 1ª iteração devolve lixo; depois fica honesto.
+  stubborn : nunca corrige."""
+import json, sys
+
+mode = sys.argv[1] if len(sys.argv) > 1 else "honest"
+req = json.load(sys.stdin)
+src, first = req["source"], req["feedback"] is None and req["iteration"] == 0
+if mode == "stubborn":
+    out = src
+elif mode == "cheater" and first:
+    out = src.replace("(pre (<= len n))", "(pre (<= len n) (< len 0))")
+elif mode == "garbage" and first:
+    out = "((("
+else:
+    out = src.replace("(while (<= i len)", "(while (< i len)")
+sys.stdout.write(out)
