 op       ::= "+" | "-" | "*" | "<=" | ">=" | "<" | ">" | "=" | "!=" | "and" | "or" | "not"
 ident    ::= [a-z_] [a-z0-9_]*
+rident   ::= [a-z_] [a-z0-9_-]*
 int      ::= "-"? [0-9]+
 string   ::= "\"" [^"]* "\""
-ws       ::= ([ \t\n] | ";;" [^\n]* "\n")*
+# comentário: ";" até o fim da linha (igual ao leitor)
+ws       ::= ([ \t\n] | ";" [^\n]* "\n")*
