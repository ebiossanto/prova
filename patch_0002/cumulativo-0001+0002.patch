diff --git a/boot/boot-aarch64.S b/boot/boot-aarch64.S
new file mode 100644
index 0000000..5ec9b58
--- /dev/null
+++ b/boot/boot-aarch64.S
@@ -0,0 +1,23 @@
+// Gerado por `prova.py boot --target aarch64`: não edite. Assume 1 núcleo (-smp 1).
+        .section .text.boot, "ax", %progbits
+        .globl  _boot
+        .type   _boot, %function
+_boot:
+        mrs     x0, CPACR_EL1                // habilita FP/SIMD (o LLVM pode usar em memcpy/memset)
+        orr     x0, x0, #(3 << 20)
+        msr     CPACR_EL1, x0
+        isb
+        adrp    x0, __stack_top
+        add     x0, x0, :lo12:__stack_top
+        mov     sp, x0
+        adrp    x1, __bss_start
+        add     x1, x1, :lo12:__bss_start
+        adrp    x2, __bss_end
+        add     x2, x2, :lo12:__bss_end
+1:      cmp     x1, x2
+        b.hs    2f
+        str     xzr, [x1], #8                // zera .bss (alinhado a 16 pelo linker script)
+        b       1b
+2:      bl      kmain
+3:      wfe
+        b       3b
diff --git a/boot/boot-riscv64.S b/boot/boot-riscv64.S
new file mode 100644
index 0000000..0f4da96
--- /dev/null
+++ b/boot/boot-riscv64.S
@@ -0,0 +1,15 @@
+# Gerado por `prova.py boot --target riscv64`: não edite. Assume 1 hart (-smp 1).
+        .section .text.boot, "ax", @progbits
+        .globl  _boot
+        .type   _boot, @function
+_boot:
+        la      sp, __stack_top
+        la      t0, __bss_start
+        la      t1, __bss_end
+1:      bgeu    t0, t1, 2f
+        sd      zero, 0(t0)                  # zera .bss (alinhado a 16 pelo linker script)
+        addi    t0, t0, 8
+        j       1b
+2:      call    kmain
+3:      wfi
+        j       3b
diff --git a/boot/boot-x86_64.S b/boot/boot-x86_64.S
new file mode 100644
index 0000000..e03663a
--- /dev/null
+++ b/boot/boot-x86_64.S
@@ -0,0 +1,16 @@
+# Gerado por `prova.py boot --target x86_64`: não edite.
+        .section .text.boot, "ax", @progbits
+        .globl  _boot
+        .type   _boot, @function
+_boot:
+        lea     __stack_top(%rip), %rsp      # pilha alinhada a 16 bytes
+        lea     __bss_start(%rip), %rdi
+        lea     __bss_end(%rip), %rcx
+        sub     %rdi, %rcx
+        xor     %eax, %eax
+        cld
+        rep stosb                            # zera .bss
+        call    kmain
+.Lhang:
+        hlt
+        jmp     .Lhang
diff --git a/boot/linker-aarch64.ld b/boot/linker-aarch64.ld
new file mode 100644
index 0000000..05a5b83
--- /dev/null
+++ b/boot/linker-aarch64.ld
@@ -0,0 +1,23 @@
+/* Gerado por `prova.py boot --target aarch64`: não edite. */
+ENTRY(_boot)
+SECTIONS
+{
+    . = 0x40080000;
+    .text   : { KEEP(*(.text.boot)) *(.text .text.*) }
+    .rodata : { *(.rodata .rodata.*) }
+    .data   : { *(.data .data.*) }
+    .bss (NOLOAD) : ALIGN(16)
+    {
+        __bss_start = .;
+        *(.bss .bss.*) *(COMMON)
+        . = ALIGN(16);
+        __bss_end = .;
+    }
+    .stack (NOLOAD) : ALIGN(16)
+    {
+        __stack_bottom = .;
+        . += 0x4000;
+        __stack_top = .;
+    }
+    /DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
+}
