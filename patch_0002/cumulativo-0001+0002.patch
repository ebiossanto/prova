+  (pre (<= len n) (<= len m))
+  (post)
+  (body
+    (var i usize 0)
+    (while (< i len)
+      (invariant (<= i len))
+      (decreases (- len i))
+      (store dst i (load src i))
+      (set i (+ i 1)))))
+
+(fn handle
+  (params (n usize) (pkt (slice u8 n net-rx))
+          (m usize) (buf (slice u8 m kmem)))
+  (returns unit)
+  (effects)
+  (pre (<= n m))
+  (post)
+  (body (do (call copy_packet n pkt m buf n))))
