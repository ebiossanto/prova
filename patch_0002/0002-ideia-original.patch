new file mode 100644
index 0000000..a32125e
--- /dev/null
+++ b/tests/test_fix_loop.py
@@ -0,0 +1,83 @@
+"""Laço fechado com a IA: o modelo corrige o CORPO; os contratos (que o humano audita) são travados.
+Usa um 'modelo' determinístico (tests/fake_model.py): nenhuma IA real, só a mecânica do laço."""
+import os, subprocess, sys, tempfile
+from _util import ROOT, build, example, problems
+from provac.loop import diff_lock, fix, lock_of
+
+FAKE = os.path.join(ROOT, "tests", "fake_model.py")
+cmd = lambda mode: f'"{sys.executable}" "{FAKE}" {mode}'
+
+
+def run_fix(mode, src=None, max_iter=4, strict=False):
+    with tempfile.NamedTemporaryFile("w", suffix=".prova", delete=False, encoding="utf-8") as f:
+        f.write(src or example("bad_bounds"))
+    try:
+        return fix(f.name, cmd(mode), max_iter, strict)
+    finally:
+        os.unlink(f.name)
+
+
+def test_honest_model_fixes_the_body_and_contracts_stay_identical():
+    r = run_fix("honest")
+    assert r["ok"] and "(while (< i len)" in r["source"]
+    assert not problems(build(r["source"]))
+    assert lock_of(r["source"]) == lock_of(example("bad_bounds"))
+
+
+def test_model_cannot_fix_by_weakening_the_contract():
+    r = run_fix("cheater")
+    assert r["ok"]
+    assert any("CONTRATO ALTERADO" in h["outcome"] for h in r["history"]), r["history"]
+    assert "(< len 0)" not in r["source"]            # a trapaça nunca chegou ao resultado
+    assert lock_of(r["source"]) == lock_of(example("bad_bounds"))
+
+
+def test_the_cheat_would_be_accepted_without_the_lock_so_the_lock_matters():
+    cheat = example("bad_bounds").replace("(pre (<= len n))", "(pre (<= len n) (< len 0))")
+    P = build(cheat)  # o corpo continua com o bug, mas todas as obrigações são provadas no vazio...
+    assert not [o for r in P.results for o in r["obligations"] if o["status"] == "failed"]
+    # ...por isso existe a checagem de pré contraditória, que o verificador agora acusa:
+    assert any("pré-condição contraditória" in p for p in problems(P))
+
+
+def test_garbage_output_is_rejected_then_recovers():
+    r = run_fix("garbage")
+    assert r["ok"] and any("fonte inválido" in h["outcome"] for h in r["history"])
+
+
+def test_gives_up_after_max_iterations():
+    r = run_fix("stubborn", max_iter=2)
+    assert not r["ok"] and "limite de 2 iterações" in r["history"][-1]["outcome"]
+
+
+def test_correct_program_never_calls_the_model():
+    r = fix(os.path.join(ROOT, "examples", "sum_to.prova"), f'"{sys.executable}" -c "import sys; sys.exit(9)"', 3)
+    assert r["ok"] and len(r["history"]) == 1
+
+
+def test_lock_allows_new_helpers_but_not_removing_or_changing_contracts():
+    base = lock_of(example("calls"))
+    added = example("calls") + "\n(fn helper (params) (returns unit) (pre) (post) (body))\n"
+    assert diff_lock(base, lock_of(added)) == []
+    removed = example("calls").split("(fn double_clamped")[0]
+    assert any("removida" in v for v in diff_lock(base, lock_of(removed)))
+    changed = example("calls").replace("(post (<= 0 result) (<= result 2000))", "(post (<= 0 result))")
+    assert any("post era" in v for v in diff_lock(base, lock_of(changed)))
+    eff = example("effects").replace("(effects syscall)", "(effects syscall atomic)", 1)
+    assert any("effects" in v for v in diff_lock(lock_of(example("effects")), lock_of(eff)))
+
+
+def test_policies_are_locked_too():
+    base = lock_of(example("regions_flow"))
+    dropped = example("regions_flow").replace("(deny-flow net-rx @write)\n", "")
+    assert any("deny-flow" in v for v in diff_lock(base, lock_of(dropped)))
+
+
+def test_cli_fix_writes_the_result():
+    with tempfile.TemporaryDirectory() as d:
+        src, out = os.path.join(d, "a.prova"), os.path.join(d, "fixed.prova")
+        open(src, "w", encoding="utf-8").write(example("bad_bounds"))
+        r = subprocess.run([sys.executable, os.path.join(ROOT, "prova.py"), "fix", src, "--model-cmd", cmd("honest"),
+                            "--out", out], capture_output=True, text=True, encoding="utf-8")
+        assert r.returncode == 0, r.stdout + r.stderr
+        assert "(while (< i len)" in open(out, encoding="utf-8").read()
diff --git a/tests/test_flow.py b/tests/test_flow.py
new file mode 100644
index 0000000..7bb8d53
--- /dev/null
+++ b/tests/test_flow.py
@@ -0,0 +1,80 @@
+"""Regiões nos tipos e fluxo de dados: o relatório mostra por onde o dado passa e (deny-flow A B) o impede,
+inclusive de forma transitiva e através de chamadas."""
+import os, subprocess, sys
+from _util import ROOT, build, example, problems, src_error
+from provac import flow as flowmod
+
+REG = "(region net-rx)\n(region kmem)\n"
+COPY = '''(fn copy (params (n usize) (src (slice u8 n net-rx)) (m usize) (dst (slice u8 m kmem)))
+  (returns unit) (effects) (pre (<= n m)) (post)
+  (body (var i usize 0)
+    (while (< i n) (invariant (<= i n)) (decreases (- n i))
+      (store dst i (load src i)) (set i (+ i 1)))))\n'''
+
+
+def edges(src):
+    P = build(src)
+    return {k: v for k, v in flowmod.concrete_edges(P.fns, P.summaries).items()}
+
+
+def test_allowed_flow_is_reported_and_policy_holds():
+    P = build(example("regions_flow"))
+    assert not problems(P)
+    assert edges(example("regions_flow")) == {("net-rx", "kmem"): "copy_packet"}
+    text = flowmod.report(P.fns, P.summaries, P.meta["denies"])
+    assert "net-rx → kmem" in text and "deny-flow net-rx @write" in text
+
+
+def test_transitive_violation_through_memory_is_caught():
+    e = src_error(example("bad_flow"))
+    assert "fluxo proibido net-rx → @write" in e
+    assert "net-rx → kmem em copy_packet" in e and "kmem → @write em leak" in e
+
+
+def test_direct_violation():
+    src = REG + '(deny-flow net-rx @write)\n' + '''(fn f (params (n usize) (b (slice u8 n net-rx))) (returns unit) (effects syscall)
+  (pre) (post) (body (do (sys_write 1 b n))))'''
+    assert "fluxo proibido net-rx → @write" in src_error(src)
+
+
+def test_region_mismatch_in_call_and_undeclared_region():
+    src = REG + COPY + '''(fn g (params (n usize) (a (slice u8 n kmem)) (m usize) (b (slice u8 m kmem))) (returns unit)
+  (effects) (pre (<= n m)) (post) (body (do (call copy n a m b))))'''
+    assert "região incompatível" in src_error(src)
+    assert "não declarada" in src_error("(fn f (params (n usize) (b (slice u8 n ghost))) (returns unit) (pre) (post) (body))")
+
+
+def test_flow_through_a_scalar_variable():
+    src = REG + '''(fn f (params (n usize) (src (slice u8 n net-rx)) (dst (slice u8 n kmem))) (returns unit)
+  (effects) (pre (< 0 n)) (post)
+  (body (let x u8 (load src 0)) (var y u8 0) (set y x) (store dst 0 y)))'''
+    assert ("net-rx", "kmem") in edges(src)
+
+
+def test_generic_region_parameters_are_instantiated_at_each_call():
+    # mv não declara regiões: o fluxo é "região do param 0 → região do param 1" e só vira concreto na chamada
+    src = REG + '''(fn mv (params (n usize) (a (slice u8 n)) (b (slice u8 n))) (returns unit) (effects) (pre (< 0 n)) (post)
+  (body (store b 0 (load a 0))))
+(fn use (params (n usize) (p (slice u8 n net-rx)) (q (slice u8 n kmem))) (returns unit) (effects) (pre (< 0 n)) (post)
+  (body (do (call mv n p q))))'''
+    assert edges(src) == {("net-rx", "kmem"): "use"}
+    assert "fluxo proibido net-rx → kmem" in src_error(src.replace(REG, REG + "(deny-flow net-rx kmem)\n"))
+
+
+def test_flow_through_atomic_cells():
+    src = REG + "(static box (atomic usize) 0)\n" + '''(fn f (params (n usize) (src (slice u8 n net-rx))) (returns unit) (effects atomic)
+  (pre (< 0 n)) (post) (body (atomic_store box (cast usize (load src 0)) relaxed)))'''
+    assert ("net-rx", "@static:box") in edges(src)
+    assert "fluxo proibido net-rx → @static:box" in src_error(src.replace(REG, REG + "(deny-flow net-rx @static:box)\n"))
+
+
+def test_deny_flow_endpoints_are_validated():
+    assert "não é região declarada" in src_error("(deny-flow ghost @write)\n(fn f (params) (returns unit) (pre) (post) (body))")
+
+
+def test_dot_output_and_cli_exit_codes():
+    run = lambda *a: subprocess.run([sys.executable, os.path.join(ROOT, "prova.py"), *a], capture_output=True,
+                                    text=True, encoding="utf-8")
+    ok = run("flow", os.path.join(ROOT, "examples", "regions_flow.prova"), "--dot")
+    assert ok.returncode == 0 and "digraph flow" in ok.stdout and '"net-rx" -> "kmem"' in ok.stdout
+    assert run("flow", os.path.join(ROOT, "examples", "bad_flow.prova")).returncode == 1
