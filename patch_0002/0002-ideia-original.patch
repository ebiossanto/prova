diff --git a/examples/atomic_counter.prova b/examples/atomic_counter.prova
new file mode 100644
index 0000000..bf1651a
--- /dev/null
+++ b/examples/atomic_counter.prova
@@ -0,0 +1,44 @@
+;; Modelo de memória concorrente: a ÚNICA memória compartilhada são células (static ... (atomic T)).
+;; Todo o resto é posse linear, então não há corrida de dados fora dos atômicos. Cada operação escolhe
+;; sua ordem de memória; ordens ilegais (load com release, store com acquire, cas com falha mais forte
+;; que o sucesso) são erro de tipo. Publicação release/acquire: o consumidor que vê ready=1 com acquire
+;; enxerga o valor gravado antes do store release.
+(static counter (atomic usize) 0)
+(static ready (atomic usize) 0)
+
+(fn bump
+  (params)
+  (returns usize)
+  (effects atomic)
+  (pre)
+  (post)
+  (body (return (atomic_fetch_add counter 1 relaxed))))
+
+(fn publish
+  (params (v usize))
+  (returns unit)
+  (effects atomic)
+  (pre)
+  (post)
+  (body
+    (atomic_store counter v relaxed)
+    (atomic_store ready 1 release)))
+
+(fn consume
+  (params)
+  (returns usize)
+  (effects atomic)
+  (pre)
+  (post)
+  (body
+    (let r usize (atomic_load ready acquire))
+    (if (= r 1) (then (return (atomic_load counter relaxed))))
+    (return 0)))
+
+(fn try_claim
+  (params)
+  (returns usize)
+  (effects atomic)
+  (pre)
+  (post)
+  (body (return (atomic_cas ready 0 1 acq_rel acquire))))
