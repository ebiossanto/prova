            | "(" ws "sys_write" ws expr ws ident ws expr ws ")"
            | "(" ws "call" ws ident (ws expr)* ws ")"
+           | "(" ws "atomic_load" ws ident ws order ws ")"
+           | "(" ws "atomic_fetch_add" ws ident ws expr ws order ws ")"
+           | "(" ws "atomic_cas" ws ident ws expr ws expr ws order ws order ws ")"
+order    ::= "relaxed" | "acquire" | "release" | "acq_rel" | "seq_cst"
 op       ::= "+" | "-" | "*" | "<=" | ">=" | "<" | ">" | "=" | "!=" | "and" | "or" | "not"
 ident    ::= [a-z_] [a-z0-9_]*
+rident   ::= [a-z_] [a-z0-9_-]*
 int      ::= "-"? [0-9]+
 string   ::= "\"" [^"]* "\""
-ws       ::= ([ \t\n] | ";;" [^\n]* "\n")*
+# comentário: ";" até o fim da linha (igual ao leitor)
+ws       ::= ([ \t\n] | ";" [^\n]* "\n")*
