;; DEVE FALHAR: o corpo tem o bug de bad_bounds, mas a pre é contraditória (usize nunca é < 0): todas as
;; obrigações seriam "provadas" no vazio. O verificador acusa a pré-condição contraditória.
(fn fill
  (params (n usize) (dst (slice u8 n)) (len usize))
  (returns unit)
  (pre (<= len n) (< len 0))
  (post)
  (body
    (var i usize 0)
    (while (<= i len)
      (invariant (<= i len))
      (decreases (- len i))
      (store dst i 0)
      (set i (+ i 1)))))
