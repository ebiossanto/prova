;; Orçamento de pilha provado pelo grafo de chamadas (sem recursão: pior caso finito).
;; Quadros vêm de um MODELO de custo; para valores reais do backend use --frames (ver provac/stack.py).
(fn leaf
  (params (x usize))
  (returns usize)
  (effects)
  (stack-budget 64)
  (pre (<= x 100))
  (post (= result (+ x 1)))
  (body (return (+ x 1))))

(fn mid
  (params (x usize))
  (returns usize)
  (effects)
  (stack-budget 128)
  (pre (<= x 100))
  (post (<= result 101))
  (body
    (let y usize (call leaf x))
    (return y)))
