new file mode 100644
index 0000000..3a3c141
--- /dev/null
+++ b/provac/flow.py
@@ -0,0 +1,199 @@
+"""Fluxo de dados por região (abordagem 3 da ideia original): mostra por onde um dado entra e onde toca a memória,
+e aplica políticas (deny-flow A B). Só fluxo EXPLÍCITO de valores (load → variável → store/syscall/atômico);
+fluxo implícito por controle (if/while) e vazamento por comprimento NÃO são rastreados.
+
+Rótulos: região concreta ("net-rx"), sumidouro "@write", célula "@static:NOME", ou ("p", i) = região/valor do
+parâmetro i (para funções genéricas). Resumos por função são instanciados em cada chamada."""
+from .check import ARITH, ATOMIC_OPS, CMP, atomic_vals, is_slice, slice_parts
+
+SINK = "@write"
+
+
+def topo(fns):
+    by = {f.name: f for f in fns}
+    seen, order = set(), []
+    from .effects import direct
+
+    def go(n):
+        if n in seen:
+            return
+        seen.add(n)
+        for c in sorted(direct(by[n])[1]):
+            go(c)
+        order.append(by[n])
+    for f in fns:
+        go(f.name)
+    return order
+
+
+def _subst(lab, sigma):
+    return set(sigma.get(lab[1], set())) if isinstance(lab, tuple) else {lab}
+
+
+class Summary:
+    def __init__(self, flows, ret):
+        self.flows, self.ret = flows, ret
+
+
+def analyse_fn(fn, sigs, summaries, meta):
+    label, taint = {}, {}
+    for i, (n, T) in enumerate(fn.params):
+        if is_slice(T):
+            r = slice_parts(T)[1]
+            label[n] = r if r else ("p", i)
+        else:
+            taint[n] = {("p", i)}
+
+    def prescan(n):
+        if isinstance(n, list):
+            if n and n[0] == "let_slice":
+                label[n[1]] = meta["data_region"].get(n[2][1], "rodata")
+            for x in n:
+                prescan(x)
+    prescan(fn.body)
+    flows, ret = set(), set()
+
+    def link(srcs, dst):
+        for s in srcs:
+            if s != dst:
+                flows.add((s, dst))
+
+    def atomic(e):
+        cell = "@static:" + e[1]
+        for v in atomic_vals(e):
+            link(tx(v), cell)
+        return set() if e[0] == "atomic_store" else {cell}
+
+    def call(e):
+        g = sigs[e[1]]
+        sigma = {}
+        for i, ((_, PT), a) in enumerate(zip(g.params, e[2:])):
+            sigma[i] = {label[a]} if is_slice(PT) else tx(a)
+        sm = summaries[g.name]
+        for (s, d) in sm.flows:
+            for s2 in _subst(s, sigma):
+                for d2 in _subst(d, sigma):
+                    if s2 != d2:
+                        flows.add((s2, d2))
+        out = set()
+        for lab in sm.ret:
+            out |= _subst(lab, sigma)
+        return out
+
+    def tx(e):
+        if isinstance(e, int):
+            return set()
+        if isinstance(e, str):
+            return set(taint.get(e, set()))
+        op = e[0]
+        if op in ARITH or op in CMP or op in ("and", "or", "not"):
+            return set().union(*[tx(x) for x in e[1:]])
+        if op == "cast":
+            return tx(e[2])
+        if op == "load":
+            return {label[e[1]]} | tx(e[2])
+        if op == "sys_write":
+            link({label[e[2]]}, SINK)
+            return set()
+        if op == "call":
+            return call(e)
+        if op in ATOMIC_OPS:
+            return atomic(e)
+        return set()  # len e afins: sem dado
+
+    def stmts(ss):
+        for s in ss:
+            h = s[0]
+            if h in ("let", "var"):
+                taint.setdefault(s[1], set()).update(tx(s[3]))
+            elif h == "set":
+                taint.setdefault(s[1], set()).update(tx(s[2]))
+            elif h == "store":
+                link(tx(s[3]), label[s[1]])
+            elif h in ("do", "sys_exit"):
+                tx(s[1])
+            elif h == "atomic_store":
+                tx(s)
+            elif h == "return" and len(s) > 1:
+                ret.update(tx(s[1]))
+            elif h == "if":
+                for part in s[2:]:
+                    stmts(part[1:])
+            elif h == "while":
+                stmts([f for f in s[2:] if f[0] not in ("invariant", "decreases")])
+
+    for _ in range(6):  # ponto fixo (variáveis são flow-insensitive: união de todas as atribuições)
+        snap = (frozenset(flows), frozenset(ret), tuple(sorted((k, frozenset(v)) for k, v in taint.items())))
+        stmts(fn.body)
+        if snap == (frozenset(flows), frozenset(ret), tuple(sorted((k, frozenset(v)) for k, v in taint.items()))):
+            break
+    return Summary(flows, ret)
+
+
+def analyse_program(fns, sigs, meta):
+    summaries = {}
+    for f in topo(fns):
+        summaries[f.name] = analyse_fn(f, sigs, summaries, meta)
+    return summaries
+
+
+def concrete_edges(fns, summaries):
+    """(origem, destino) -> primeira função (callee primeiro) em que o fluxo aparece."""
+    edges = {}
+    for f in topo(fns):
+        for (a, b) in sorted(summaries[f.name].flows, key=str):
+            if isinstance(a, str) and isinstance(b, str):
+                edges.setdefault((a, b), f.name)
+    return edges
+
+
+def check_denies(fns, summaries, denies):
+    """Violação = destino alcançável da origem pelo grafo de fluxos de TODO o programa (inclui via memória)."""
+    edges = concrete_edges(fns, summaries)
+    adj = {}
+    for (a, b) in edges:
+        adj.setdefault(a, []).append(b)
+    errs = []
+    for (a, b) in denies:
+        prev, queue = {a: None}, [a]
+        while queue:
+            x = queue.pop(0)
+            for y in adj.get(x, ()):
+                if y not in prev:
+                    prev[y] = x
+                    queue.append(y)
+        if b in prev:
+            path, n = [], b
+            while n is not None:
+                path.append(n)
+                n = prev[n]
+            path.reverse()
+            hops = ", ".join(f"{path[i]} → {path[i + 1]} em {edges[(path[i], path[i + 1])]}" for i in range(len(path) - 1))
+            errs.append(f"fluxo proibido {a} → {b} (deny-flow {a} {b}): {hops}")
+    return errs
+
+
+def report(fns, summaries, denies, dot=False):
+    edges = concrete_edges(fns, summaries)
+    if dot:
+        lines = ["digraph flow {", "  rankdir=LR;"]
+        for (a, b), f in sorted(edges.items()):
+            bad = " color=red" if (a, b) in denies else ""
+            lines.append(f'  "{a}" -> "{b}" [label="{f}"{bad}];')
+        return "\n".join(lines + ["}"]) + "\n"
+    out = ["Fluxos de dados entre regiões (explícitos; sem fluxo por controle):"]
+    for f in topo(fns):
+        conc = sorted((a, b) for (a, b) in summaries[f.name].flows if isinstance(a, str) and isinstance(b, str))
+        poly = sorted((a, b) for (a, b) in summaries[f.name].flows if not (isinstance(a, str) and isinstance(b, str)))
+        if not (conc or poly):
+            continue
+        out.append(f"  fn {f.name}")
+        for a, b in conc:
+            out.append(f"    {a} → {b}")
+        for a, b in poly:
+            fmt = lambda x: f"param#{x[1]}" if isinstance(x, tuple) else x
+            out.append(f"    {fmt(a)} → {fmt(b)}   (genérico: região do parâmetro)")
+    if len(out) == 1:
+        out.append("  (nenhum fluxo entre regiões distintas)")
+    out.append("Políticas: " + (", ".join(f"deny-flow {a} {b}" for a, b in denies) or "nenhuma"))
+    return "\n".join(out)
diff --git a/provac/interp.py b/provac/interp.py
new file mode 100644
index 0000000..aea1281
--- /dev/null
+++ b/provac/interp.py
@@ -0,0 +1,307 @@
+"""Interpretador de referência da Prova.
+
+NÃO é um backend: não gera código nativo. Serve para (1) EXECUTAR programas Prova onde não há LLVM e
+(2) validar o verificador: confere em tempo de execução tudo que ele prometeu (pre, post, invariantes,
+variante decrescente, limites, overflow, ordem das syscalls). Se um programa verificado violar algo aqui,
+o bug é do verificador (ou do interpretador): é um teste diferencial."""
+import random
+
+from .check import ARITH, CMP, HI, LO, ProvaError, is_slice, show, slice_parts, ty
+
+FUEL = 5_000_000
+
+
+class RunError(Exception):
+    """Violação em tempo de execução (overflow, fora dos limites, contrato, invariante...)."""
+
+
+class Inconclusive(RunError):
+    """A execução gastou todo o combustível (passos/iterações). NÃO é violação: é só lenta demais para o teste."""
+
+
+class Exit(Exception):
+    def __init__(self, code):
+        self.code = code
+
+
+class Ret(Exception):
+    def __init__(self, value):
+        self.value = value
+
+
+class Slice:
+    def __init__(self, data):
+        self.data = bytearray(data)
+
+
+class Frame:
+    def __init__(self, fn, cx):
+        self.fn, self.cx, self.env, self.slices = fn, cx, {}, {}
+
+
+class Result:
+    def __init__(self, exit_code, out, err, statics, returned):
+        self.exit_code, self.stdout, self.stderr, self.statics, self.returned = exit_code, out, err, statics, returned
+
+
+class Machine:
+    def __init__(self, P, check=True, fuel=FUEL):
+        self.P, self.check, self.fuel = P, check, fuel
+        self.cx = {fn.name: cx for fn, cx in P.compiled}
+        self.out, self.err = bytearray(), bytearray()
+        self.statics = dict(P.meta["static_init"])
+        self.steps = 0
+
+    # ---------- contratos (inteiros matemáticos, sem faixa) ----------
+    def gh(self, e, F, result=None):
+        if isinstance(e, int):
+            return e
+        if isinstance(e, str):
+            if e == "result":
+                return result
+            return F.env[e]
+        op = e[0]
+        if op in ARITH:
+            a, b = self.gh(e[1], F, result), self.gh(e[2], F, result)
+            return a + b if op == "+" else a - b if op == "-" else a * b
+        if op in CMP:
+            a, b = self.gh(e[1], F, result), self.gh(e[2], F, result)
+            return {"<": a < b, "<=": a <= b, ">": a > b, ">=": a >= b, "=": a == b, "!=": a != b}[op]
+        if op == "and":
+            return all(self.gh(x, F, result) for x in e[1:])
+        if op == "or":
+            return any(self.gh(x, F, result) for x in e[1:])
+        if op == "not":
+            return not self.gh(e[1], F, result)
+        if op == "len":
+            return len(F.slices[e[1]].data)
+        raise RunError(f"forma não avaliável em contrato: {show(e)}")
+
+    def need(self, cond, what):
+        if self.check and not cond:
+            raise RunError(what)
+
+    # ---------- expressões ----------
+    def fit(self, v, T, what):
+        if not LO[T] <= v <= HI[T]:
+            raise RunError(f"{what}: {v} fora da faixa de {T}")
+        return v
+
+    def ex(self, e, F, want=None):
+        if isinstance(e, int):
+            return e
+        if isinstance(e, str):
+            return F.env[e]
+        op = e[0]
+        if op in ARITH:
+            T = ty(e, F.cx) or want or "i64"
+            a, b = self.ex(e[1], F, T), self.ex(e[2], F, T)
+            v = a + b if op == "+" else a - b if op == "-" else a * b
+            return self.fit(v, T, f"overflow em {show(e)}")
+        if op in CMP:
+            a, b = self.ex(e[1], F), self.ex(e[2], F)
+            return {"<": a < b, "<=": a <= b, ">": a > b, ">=": a >= b, "=": a == b, "!=": a != b}[op]
+        if op == "and":
+            return all(self.ex(x, F) for x in e[1:])
+        if op == "or":
+            return any(self.ex(x, F) for x in e[1:])
+        if op == "not":
+            return not self.ex(e[1], F)
+        if op == "len":
+            return len(F.slices[e[1]].data)
+        if op == "load":
+            s, i = F.slices[e[1]], self.ex(e[2], F, "usize")
+            if not 0 <= i < len(s.data):
+                raise RunError(f"leitura fora dos limites: {show(e)} com índice {i} e tamanho {len(s.data)}")
+            return s.data[i]
+        if op == "cast":
+            return self.fit(self.ex(e[2], F), e[1], f"cast {show(e)}")
+        if op == "sys_write":
+            fd, s, n = self.ex(e[1], F, "i64"), F.slices[e[2]], self.ex(e[3], F, "usize")
+            if not 0 <= n <= len(s.data):
+                raise RunError(f"sys_write de {n} bytes excede o buffer de {len(s.data)}")
+            if fd == 1:
+                self.out += s.data[:n]
+            elif fd == 2:
+                self.err += s.data[:n]
+            else:
+                return -9  # EBADF
+            return n
+        if op == "call":
+            g = self.P.sigs[e[1]]
+            args = [F.slices[a] if is_slice(PT) else self.ex(a, F, PT) for (_, PT), a in zip(g.params, e[2:])]
+            return self.call(g.name, args)
+        if op in ("atomic_load", "atomic_store", "atomic_fetch_add", "atomic_cas"):
+            return self.atomic(e, F)
+        raise RunError(f"forma desconhecida: {show(e)}")
+
+    def atomic(self, e, F):
+        name = e[1]
+        T = self.P.meta["statics"][name]
+        wrap = (lambda v: v % 2**64) if T == "usize" else (lambda v: (v + 2**63) % 2**64 - 2**63)
+        old = self.statics[name]
+        if e[0] == "atomic_load":
+            return old
+        if e[0] == "atomic_store":
+            self.statics[name] = self.fit(self.ex(e[2], F, T), T, f"atomic_store em {name}")
+            return None
+        if e[0] == "atomic_fetch_add":
+            self.statics[name] = wrap(old + self.ex(e[2], F, T))
+            return old
+        exp, new = self.ex(e[2], F, T), self.ex(e[3], F, T)
+        if old == exp:
+            self.statics[name] = new
+        return old
+
+    # ---------- instruções ----------
+    def block(self, stmts, F):
+        for s in stmts:
+            self.stmt(s, F)
+
+    def stmt(self, s, F):
+        self.steps += 1
+        if self.steps > self.fuel * 4:
+            raise Inconclusive("limite de passos excedido")
+        h = s[0]
+        if h in ("let", "var"):
+            F.env[s[1]] = self.fit(self.ex(s[3], F, s[2]), s[2], f"{h} {s[1]}")
+        elif h == "set":
+            F.env[s[1]] = self.fit(self.ex(s[2], F, F.cx.types[s[1]]), F.cx.types[s[1]], f"set {s[1]}")
+        elif h == "let_slice":
+            F.slices[s[1]] = Slice(self.P.data[s[2][1]])
+        elif h == "store":
+            sl, i = F.slices[s[1]], self.ex(s[2], F, "usize")
+            if not 0 <= i < len(sl.data):
+                raise RunError(f"escrita fora dos limites: {show(s)} com índice {i} e tamanho {len(sl.data)}")
+            sl.data[i] = self.fit(self.ex(s[3], F, "u8"), "u8", f"store {show(s)}")
+        elif h in ("do", "atomic_store"):
+            self.ex(s[1] if h == "do" else s, F)
+        elif h == "assert":
+            self.need(self.gh(s[1], F), f"assert falhou: {show(s[1])}")
+        elif h == "drop":
+            pass
+        elif h == "return":
+            raise Ret(self.ex(s[1], F, F.fn.ret) if len(s) > 1 else None)
+        elif h == "sys_exit":
+            raise Exit(self.ex(s[1], F, "i64"))
+        elif h == "if":
+            branch = "then" if self.ex(s[1], F) else "else"
+            for part in s[2:]:
+                if part[0] == branch:
+                    self.block(part[1:], F)
+        elif h == "while":
+            self.loop(s, F)
+        else:
+            raise RunError(f"instrução desconhecida: {show(s)}")
+
+    def loop(self, s, F):
+        inv = [x for f in s[2:] if f[0] == "invariant" for x in f[1:]]
+        dec = next(f[1] for f in s[2:] if f[0] == "decreases")
+        body = [f for f in s[2:] if f[0] not in ("invariant", "decreases")]
+        prev = None
+        for _ in range(self.fuel):
+            for I in inv:
+                self.need(self.gh(I, F), f"invariante violada: {show(I)}")
+            if not self.ex(s[1], F):
+                return
+            d = self.gh(dec, F)
+            self.need(d >= 0, f"variante negativa: {show(dec)} = {d}")
+            self.need(prev is None or d < prev, f"variante não decresceu: {show(dec)} foi {prev} e agora é {d}")
+            prev = d
+            self.block(body, F)
+        raise Inconclusive("laço excedeu o limite de iterações")
+
+    # ---------- chamadas ----------
+    def call(self, name, args):
+        fn = self.P.sigs[name]
+        F = Frame(fn, self.cx[name])
+        for (pn, PT), a in zip(fn.params, args):
+            if is_slice(PT):
+                F.slices[pn] = a
+            else:
+                F.env[pn] = self.fit(a, PT, f"argumento {pn} de {name}")
+        for p in fn.pre:
+            self.need(self.gh(p, F), f"pré-condição de {name} violada: {show(p)}")
+        ret = None
+        try:
+            self.block(fn.body, F)
+        except Ret as r:
+            ret = r.value
+        for q in fn.post:
+            self.need(self.gh(q, F, ret), f"pós-condição de {name} violada: {show(q)} (result = {ret})")
+        return ret
+
+
+def run(P, entry="_start", args=(), check=True):
+    """Executa `entry`. Retorna Result; levanta RunError se o programa violar algo."""
+    if entry not in P.sigs:
+        raise ProvaError(f"função de entrada '{entry}' não existe")
+    m = Machine(P, check)
+    code = ret = None
+    try:
+        ret = m.call(entry, list(args))
+        code = 0
+    except Exit as e:
+        code = e.code
+    return Result(code, bytes(m.out), bytes(m.err), dict(m.statics), ret), m
+
+
+# ---------- teste diferencial: entradas aleatórias que satisfazem a pre ----------
+SCALAR_POOL = [0, 1, 2, 3, 5, 8, 10, 50, 100, 255, 256, 999, 1000, 4096, 4097, 65535]
+SMALL_POOL = [0, 1, 2, 3, 5, 8, 10, 21, 48, 50, 100]   # a maioria das entradas é pequena: laços terminam rápido
+FUZZ_FUEL = 5_000                                      # combustível curto: execução longa = inconclusivo, não falha
+
+
+def gen_args(fn, rnd):
+    lens = {slice_parts(T)[0] for _, T in fn.params if is_slice(T)}
+    args, vals = [], {}
+    for pn, T in fn.params:
+        if is_slice(T):
+            n = vals[slice_parts(T)[0]]
+            args.append(Slice(bytes(rnd.randrange(256) for _ in range(n))))
+        else:
+            if pn in lens:
+                v = rnd.choice([0, 1, 2, 3, 4, 7, 16, 33, 100])
+            elif rnd.random() < 0.6:
+                v = max(LO[T], min(HI[T], rnd.choice(SMALL_POOL)))
+            else:
+                pool = SCALAR_POOL + [rnd.randrange(LO[T] if T != "i64" else -2**63, HI[T] + 1) % (HI[T] + 1)
+                                       if T != "i64" else rnd.randrange(-2**63, 2**63)]
+                if T == "i64":
+                    pool += [-1, -2, 2**63 - 1, -2**63]
+                v = rnd.choice(pool)
+                if not LO[T] <= v <= HI[T]:
+                    v = max(LO[T], min(HI[T], v))
+            vals[pn] = v
+            args.append(v)
+    return args
+
+
+def fuzz_function(P, name, runs=400, seed=1):
+    """Chama `name` com entradas aleatórias; só conta as que satisfazem a pre e terminam dentro do combustível
+    (execução longa demais é inconclusiva, não violação). Retorna (executadas, violações)."""
+    fn, rnd = P.sigs[name], random.Random(seed)
+    executed, violations = 0, []
+    for _ in range(runs):
+        args = gen_args(fn, rnd)
+        m = Machine(P, check=True, fuel=FUZZ_FUEL)
+        F = Frame(fn, m.cx[name])
+        for (pn, PT), a in zip(fn.params, args):
+            (F.slices if is_slice(PT) else F.env)[pn] = a
+        try:
+            if not all(m.gh(p, F) for p in fn.pre):
+                continue
+        except (RunError, KeyError):
+            continue
+        try:
+            m.call(name, args)
+            executed += 1
+        except Exit:
+            executed += 1
+        except Inconclusive:
+            continue
+        except RunError as e:
+            executed += 1
+            violations.append((args if not any(isinstance(a, Slice) for a in args)
+                               else [a if not isinstance(a, Slice) else bytes(a.data) for a in args], str(e)))
+    return executed, violations
