diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 0000000..9ef8aa0
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,6 @@
+* text=auto
+*.prova text eol=lf
+*.S text eol=lf
+*.ld text eol=lf
+*.gbnf text eol=lf
+*.sh text eol=lf
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..9bee635
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,17 @@
+name: ci
+on: [push, pull_request]
+jobs:
+  test:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, windows-latest]
+        python: ["3.12", "3.13"]
+    runs-on: ${{ matrix.os }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python }}
+      - name: Testes (o runner sai com código != 0 se algum teste falhar)
+        run: python tests/run_tests.py
diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..1b3e422
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1,8 @@
+__pycache__/
+*.pyc
+.pytest_cache/
+build/
+*.zip
+*_out.txt
+lean/.lake/
+lean/lake-manifest.json
