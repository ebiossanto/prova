+"""Demonstração de ponta a ponta (examples/driver_demo.prova): contratos, posse/tamanhos, efeitos, regiões com
+política, pilha, atômicos e syscalls juntos; e as três visões que o humano usa (audit, flow, stack)."""
+from _util import build, example, pending, problems
+from provac import flow as flowmod
+from provac.audit import audit
+from provac.mlir import emit_module
+from provac.program import load_text
+
+
+def test_demo_is_fully_proved_with_no_policy_errors():
+    P = build(example("driver_demo"))
+    assert not problems(P) and not pending(P)
+
+
+def test_audit_view_has_only_what_a_human_needs_to_read():
+    _, fns, meta = load_text(example("driver_demo"))
+    text = audit(fns, meta)
+    for needle in ("política  deny-flow net-rx @write", "static    received: (atomic usize) = 0",
+                   "exige    (<= n m)", "efeitos  atomic", "efeitos  syscall", "efeitos  nenhum (pura)",
+                   "pilha    ≤ 256 bytes", "corpo    chama copy_in"):
+        assert needle in text, needle
+    assert "invariant" not in text and "while" not in text   # o corpo não precisa ser lido
+
+
+def test_flow_and_stack_views():
+    P = build(example("driver_demo"))
+    assert flowmod.concrete_edges(P.fns, P.summaries) == {
+        ("net-rx", "kmem"): "copy_in", ("rodata", "@write"): "announce"}
+    assert P.worst["on_packet"] == (144, ["on_packet", "copy_in"])   # modelo: 64 + 80
+
+
+def test_demo_emits_on_every_target():
+    P = build(example("driver_demo"))
+    for t in ("x86_64", "aarch64", "riscv64"):
+        text = emit_module(P.compiled, P.data, t)
+        assert "llvm.atomicrmw add" in text and "func.call @copy_in" in text and "llvm.inline_asm" in text
diff --git a/tests/test_effects.py b/tests/test_effects.py
new file mode 100644
index 0000000..682c7fc
--- /dev/null
+++ b/tests/test_effects.py
@@ -0,0 +1,43 @@
+"""Efeitos na assinatura: sem (effects ...) a função é pura; o efeito de um chamado propaga ao chamador."""
+from _util import ROOT, build, example, pending, problems, src_error  # noqa: F401
+from provac.audit import audit
+from provac.program import load_text
+
+SYS = '(data m "x")\n'
+NOISY = SYS + '''(fn noisy (params) (returns unit) (effects syscall) (pre) (post)
+  (body (let_slice b (data-ref m)) (do (sys_write 1 b (len b)))))\n'''
+
+
+def test_declared_effects_are_accepted_and_proved():
+    P = build(example("effects"))
+    assert not problems(P) and not pending(P)
+
+
+def test_pure_function_cannot_call_an_effectful_one():
+    e = src_error(example("bad_effect").replace(";; DEVE", ";; deve"))
+    assert "efeito 'syscall' não declarado" in e and "a chamada a noisy" in e
+
+
+def test_missing_clause_means_pure_and_body_syscall_is_rejected():
+    e = src_error(SYS + '(fn f (params) (returns unit) (pre) (post) (body (let_slice b (data-ref m)) (do (sys_write 1 b (len b)))))')
+    assert "efeito 'syscall' não declarado" in e and "o corpo" in e
+
+
+def test_effect_propagates_through_two_levels():
+    src = NOISY + '''(fn mid (params) (returns unit) (effects syscall) (pre) (post) (body (do (call noisy))))
+(fn top (params) (returns unit) (effects) (pre) (post) (body (do (call mid))))'''
+    e = src_error(src)
+    assert "top: efeito 'syscall' não declarado" in e and "a chamada a mid" in e
+    assert "mid: efeito" not in e  # mid declarou corretamente
+
+
+def test_unknown_effect_and_overdeclaration():
+    assert "efeito desconhecido" in src_error("(fn f (params) (returns unit) (effects magic) (pre) (post) (body))")
+    # declarar a mais é permitido (o contrato pode ser mais largo que o corpo)
+    assert src_error("(fn f (params) (returns unit) (effects syscall atomic) (pre) (post) (body))") is None
+
+
+def test_audit_shows_effects():
+    _, fns, meta = load_text(example("effects"))
+    text = audit(fns, meta)
+    assert "efeitos  nenhum (pura)" in text and "efeitos  syscall" in text
diff --git a/tests/test_emit.py b/tests/test_emit.py
new file mode 100644
index 0000000..23af5bd
--- /dev/null
+++ b/tests/test_emit.py
@@ -0,0 +1,71 @@
+"""Emissão MLIR: cobre `emit` (que não tinha nenhum teste e quebrou em `KeyError: '<'`) em todos os
+alvos, e trava a tradução de syscalls por arquitetura (fd=1, exit(0), números e registradores certos)."""
+import os, re, subprocess, sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+import prova  # noqa: E402
+from provac.mlir import emit_module  # noqa: E402
+
+EX = os.path.join(ROOT, "examples")
+GOOD = ["sum_to", "copy_bytes", "hello", "ok_own", "calls",
+        "x86_64_start", "aarch64_start", "riscv64_start", "kmain_min",
+        "effects", "regions_flow", "stack_budget", "atomic_counter", "driver_demo", "packet_inspector", "selftest"]
+TARGETS = ("x86_64", "aarch64", "riscv64")
+WRITE_NR = {"x86_64": 1, "aarch64": 64, "riscv64": 64}
+EXIT_NR = {"x86_64": 60, "aarch64": 93, "riscv64": 93}
+
+
+def emit(name, target):
+    data, compiled, _ = prova.analyse(os.path.join(EX, name + ".prova"))
+    return emit_module(compiled, data, target)
+
+
+def test_every_good_example_emits_on_every_target():
+    for name in GOOD:
+        for t in TARGETS:
+            text = emit(name, t)
+            assert text.startswith("module {") and text.rstrip().endswith("}"), (name, t)
+            assert "func.func @" in text, (name, t)
+            assert "!volatile" not in text, "sintaxe inválida de MLIR não pode voltar"
+
+
+def test_comparisons_and_overflow_flags_are_emitted():
+    # regressão: `op in ARITH or op in CMP` deixava o ramo de comparações inalcançável
+    text = emit("sum_to", "x86_64")
+    assert "arith.cmpi ult" in text and "overflow<nuw>" in text
+    assert "func.call @clamp" in emit("calls", "x86_64")
+    assert "memref.store" in emit("copy_bytes", "x86_64")
+
+
+def _asm_calls(text):
+    consts = dict(re.findall(r"(%t\d+) = arith\.constant (-?\d+) : i64", text))
+    out = []
+    for m in re.finditer(r'llvm\.inline_asm [^"]*"([^"]*)", "([^"]*)" ([^:]*) :', text):
+        ops = [x.strip() for x in m.group(3).split(",")]
+        out.append((m.group(1), m.group(2), [int(consts[o]) if o in consts else None for o in ops]))
+    return out
+
+
+def test_syscall_translation_per_architecture():
+    insn = {"x86_64": "syscall", "aarch64": "svc #0", "riscv64": "ecall"}
+    for t in TARGETS:
+        calls = _asm_calls(emit(f"{t}_start", t))
+        assert len(calls) == 2, (t, calls)
+        (i1, _, ops1), (i2, _, ops2) = calls
+        assert i1 == i2 == insn[t]
+        assert ops1[0] == WRITE_NR[t] and ops1[1] == 1, f"{t}: write precisa de nr={WRITE_NR[t]} e fd=1, veio {ops1}"
+        assert ops2[0] == EXIT_NR[t] and ops2[1] == 0, f"{t}: exit precisa de nr={EXIT_NR[t]} e código 0, veio {ops2}"
+
+
+def test_start_examples_use_len_and_stdout():
+    for t in TARGETS:
+        src = open(os.path.join(EX, f"{t}_start.prova"), encoding="utf-8").read()
+        assert "(sys_write 1 b (len b))" in src and "(sys_exit 0)" in src, t
+
+
+def test_cli_refuses_to_emit_a_failing_program():
+    r = subprocess.run([sys.executable, os.path.join(ROOT, "prova.py"), "emit", os.path.join(EX, "bad_inc.prova")],
+                       capture_output=True, text=True, encoding="utf-8")
+    assert r.returncode == 1 and "emissão recusada" in r.stderr
+    assert "func.func" not in r.stdout
diff --git a/tests/test_fix_loop.py b/tests/test_fix_loop.py
