diff --git a/examples/packet_inspector.prova b/examples/packet_inspector.prova
new file mode 100644
index 0000000..981d087
--- /dev/null
+++ b/examples/packet_inspector.prova
@@ -0,0 +1,105 @@
+;; Programa de teste de ponta a ponta: um INSPETOR DE PACOTES.
+;;   - pacotes chegam na região net-rx; a política proíbe que dado de net-rx saia pela saída (@write);
+;;   - cada pacote é validado (tamanho mínimo + byte mágico 'P' = 80) e, se válido, somado (checksum);
+;;   - contadores e o último checksum ficam em células atômicas (a única memória compartilhada);
+;;   - o veredito ("ACCEPT"/"DROP") sai por syscall; o código de saída é o número de pacotes aceitos.
+;; Tudo é provado: sem overflow, sem acesso fora dos limites, terminação, contratos, efeitos, pilha e política.
+;;   python prova.py check|audit|flow|stack|emit|run examples/packet_inspector.prova
+(region net-rx)
+(deny-flow net-rx @write)
+
+(static accepted (atomic usize) 0)
+(static dropped (atomic usize) 0)
+(static last_sum (atomic usize) 0)
+
+(data pkt_ok "PING hello" net-rx)
+(data pkt_bad "xyz" net-rx)
+(data pkt_short "P" net-rx)
+(data msg_ok "ACCEPT\n")
+(data msg_drop "DROP\n")
+
+;; Soma dos bytes. Cota provada: cada byte vale no máximo 255, logo a soma nunca passa de 255*n.
+(fn checksum
+  (params (n usize) (buf (slice u8 n net-rx)))
+  (returns usize)
+  (effects)
+  (stack-budget 128)
+  (pre (<= n 4096))
+  (post (<= result (* 255 n)))
+  (body
+    (var i usize 0)
+    (var s usize 0)
+    (while (< i n)
+      (invariant (<= i n) (<= s (* 255 i)))
+      (decreases (- n i))
+      (set s (+ s (cast usize (load buf i))))
+      (set i (+ i 1)))
+    (return s)))
+
+;; 1 se o pacote tem pelo menos 2 bytes e começa com o byte mágico 'P' (80).
+(fn well_formed
+  (params (n usize) (buf (slice u8 n net-rx)))
+  (returns usize)
+  (effects)
+  (stack-budget 64)
+  (pre)
+  (post (<= result 1))
+  (body
+    (if (< n 2) (then (return 0)))
+    (if (= (load buf 0) 80) (then (return 1)))
+    (return 0)))
+
+;; Valida, soma e contabiliza. Retorna 1 se aceitou.
+(fn inspect
+  (params (n usize) (pkt (slice u8 n net-rx)))
+  (returns usize)
+  (effects atomic)
+  (stack-budget 256)
+  (pre (<= n 4096))
+  (post (<= result 1))
+  (body
+    (let ok usize (call well_formed n pkt))
+    (if (= ok 1)
+      (then
+        (let sum usize (call checksum n pkt))
+        (atomic_store last_sum sum relaxed)
+        (do (atomic_fetch_add accepted 1 relaxed))
+        (return 1)))
+    (do (atomic_fetch_add dropped 1 relaxed))
+    (return 0)))
+
+;; O texto do veredito vem de rodata, nunca do pacote.
+(fn verdict
+  (params (ok usize))
+  (returns unit)
+  (effects syscall)
+  (stack-budget 128)
+  (pre (<= ok 1))
+  (post)
+  (body
+    (if (= ok 1)
+      (then
+        (let_slice a (data-ref msg_ok))
+        (do (sys_write 1 a (len a)))
+        (return)))
+    (let_slice d (data-ref msg_drop))
+    (do (sys_write 1 d (len d)))))
+
+(fn _start
+  (params)
+  (returns unit)
+  (effects syscall atomic)
+  (stack-budget 512)
+  (pre)
+  (post)
+  (body
+    (let_slice a (data-ref pkt_ok))
+    (let_slice b (data-ref pkt_bad))
+    (let_slice c (data-ref pkt_short))
+    (let ra usize (call inspect (len a) a))
+    (do (call verdict ra))
+    (let rb usize (call inspect (len b) b))
+    (do (call verdict rb))
+    (let rc usize (call inspect (len c) c))
+    (do (call verdict rc))
+    (sys_exit (cast i64 (+ (+ ra rb) rc)))))
diff --git a/examples/selftest.prova b/examples/selftest.prova
new file mode 100644
index 0000000..ee806e6
--- /dev/null
+++ b/examples/selftest.prova
@@ -0,0 +1,175 @@
+;; selftest.prova: um programa de TESTE escrito em Prova, que testa a si mesmo.
+;;
+;;  - Estaticamente (prova.py check): todas as obrigações são provadas: sem overflow, sem acesso fora dos
+;;    limites, todo laço termina, contratos valem e nenhum dado da região `input` chega à saída.
+;;  - Dinamicamente (prova.py run): _start roda os casos e escreve PASS ou FAIL; o código de saída é 0 ou 1.
+;;
+;; Limites honestos: a Prova ainda não expressa "o vetor ficou ordenado" em contrato (conteúdo de fatias não é
+;; modelado). Para sort e reverse a prova estática cobre segurança de memória e terminação; a CORREÇÃO funcional
+;; é verificada por execução em tests/test_selftest.py (comparando com o Python).
+
+(region input)
+(deny-flow input @write)                      ; dado de entrada nunca vai para a saída
+
+(data sample "Hello, Prova!" input)
+(data pass_msg "PASS\n")
+(data fail_msg "FAIL\n")
+
+;; ---- máximo divisor comum por subtração: termina porque x+y decresce, nunca subtrai abaixo de zero ----
+(fn gcd
+  (params (a usize) (b usize))
+  (returns usize)
+  (effects)
+  (stack-budget 128)
+  (pre (<= 1 a) (<= 1 b))
+  (post (<= 1 result) (<= result a) (<= result b))
+  (body
+    (var x usize a)
+    (var y usize b)
+    (while (!= x y)
+      (invariant (<= 1 x) (<= 1 y) (<= x a) (<= y b))
+      (decreases (+ x y))
+      (if (> x y)
+        (then (set x (- x y)))
+        (else (set y (- y x)))))
+    (return x)))
+
+;; ---- soma dos bytes: provado que não estoura e que soma <= 255 * n ----
+(fn sum_bytes
+  (params (n usize) (buf (slice u8 n)))
+  (returns usize)
+  (effects)
+  (stack-budget 128)
+  (pre (<= n 1000))
+  (post (<= result (* 255 n)))
+  (body
+    (var i usize 0)
+    (var s usize 0)
+    (while (< i n)
+      (invariant (<= i n) (<= s (* 255 i)))
+      (decreases (- n i))
+      (set s (+ s (cast usize (load buf i))))
+      (set i (+ i 1)))
+    (return s)))
+
+;; ---- quantas vezes o byte v aparece ----
+(fn count_byte
+  (params (n usize) (buf (slice u8 n)) (v u8))
+  (returns usize)
+  (effects)
+  (stack-budget 128)
+  (pre)
+  (post (<= result n))
+  (body
+    (var i usize 0)
+    (var c usize 0)
+    (while (< i n)
+      (invariant (<= i n) (<= c i))
+      (decreases (- n i))
+      (if (= (load buf i) v) (then (set c (+ c 1))))
+      (set i (+ i 1)))
+    (return c)))
+
+;; ---- maior byte ----
+(fn max_byte
+  (params (n usize) (buf (slice u8 n)))
+  (returns u8)
+  (effects)
+  (stack-budget 128)
+  (pre (< 0 n))
+  (post (<= 0 result))
+  (body
+    (var i usize 0)
+    (var m u8 0)
+    (while (< i n)
+      (invariant (<= i n))
+      (decreases (- n i))
+      (let b u8 (load buf i))
+      (if (> b m) (then (set m b)))
+      (set i (+ i 1)))
+    (return m)))
+
+;; ---- ordenação por bolhas, no lugar: prova estática = memória segura + termina ----
+(fn sort
+  (params (n usize) (buf (slice u8 n)))
+  (returns unit)
+  (effects)
+  (stack-budget 128)
+  (pre (<= n 1000))
+  (post)
+  (body
+    (var pass usize 0)
+    (while (< pass n)
+      (invariant (<= pass n))
+      (decreases (- n pass))
+      (var j usize 0)
+      (while (< (+ j 1) (- n pass))
+        (invariant (<= j (- n pass)))
+        (decreases (- (- n pass) j))
+        (let x u8 (load buf j))
+        (let y u8 (load buf (+ j 1)))
+        (if (> x y)
+          (then (store buf j y)
+                (store buf (+ j 1) x)))
+        (set j (+ j 1)))
+      (set pass (+ pass 1)))))
+
+;; ---- inverte no lugar ----
+;; (pre (<= n 1000000)): sem esse limite o verificador acha um overflow real em (+ lo 1) quando n = 2^64-1.
+(fn reverse
+  (params (n usize) (buf (slice u8 n)))
+  (returns unit)
+  (effects)
+  (stack-budget 128)
+  (pre (<= n 1000000))
+  (post)
+  (body
+    (var lo usize 0)
+    (var hi usize n)
+    (while (< (+ lo 1) hi)
+      (invariant (<= lo hi) (<= hi n))
+      (decreases (- hi lo))
+      (let p u8 (load buf lo))
+      (let q u8 (load buf (- hi 1)))
+      (store buf lo q)
+      (store buf (- hi 1) p)
+      (set lo (+ lo 1))
+      (set hi (- hi 1)))))
+
+;; ---- 0 se o obtido é o esperado, 1 se não: soma as falhas sem ramificar _start ----
+(fn expect
+  (params (got usize) (want usize))
+  (returns usize)
+  (effects)
+  (stack-budget 64)
+  (pre)
+  (post (<= result 1))
+  (body
+    (if (= got want)
+      (then (return 0))
+      (else (return 1)))))
+
+(fn _start
+  (params)
+  (returns unit)
+  (effects syscall)
+  (stack-budget 512)
+  (pre)
+  (post)
+  (body
+    (let_slice s (data-ref sample))
+    (var failures usize 0)
+    (set failures (+ failures (call expect (call gcd 48 18) 6)))
+    (set failures (+ failures (call expect (call gcd 17 5) 1)))
+    (set failures (+ failures (call expect (call gcd 21 21) 21)))
+    (set failures (+ failures (call expect (call gcd 270 192) 6)))
+    (set failures (+ failures (call expect (call sum_bytes (len s) s) 1129)))
+    (set failures (+ failures (call expect (call count_byte (len s) s 111) 2)))
+    (set failures (+ failures (call expect (cast usize (call max_byte (len s) s)) 118)))
+    (if (= failures 0)
+      (then (let_slice ok (data-ref pass_msg))
+            (do (sys_write 1 ok (len ok)))
+            (sys_exit 0))
+      (else (let_slice bad (data-ref fail_msg))
+            (do (sys_write 1 bad (len bad)))
+            (sys_exit 1)))))
