index 0000000..b69cf0c
--- /dev/null
+++ b/tests/test_packet_inspector.py
@@ -0,0 +1,55 @@
+"""O programa de teste (examples/packet_inspector.prova) e erros realistas nele: cada bug plausível é recusado
+pelo verificador pelo motivo certo, e o mesmo bug falha também em tempo de execução."""
+from _util import build, example, pending, problems
+from provac.interp import RunError, run
+
+BASE = example("packet_inspector")
+
+
+def mutated(old, new):
+    assert old in BASE, old
+    return BASE.replace(old, new, 1)
+
+
+def test_the_unmodified_program_is_fully_proved_and_clean():
+    P = build(BASE)
+    assert not problems(P) and not pending(P)
+    assert len([o for r in P.results for o in r["obligations"]]) >= 55
+
+
+def test_off_by_one_in_the_loop_is_caught_statically_and_at_runtime():
+    src = mutated("(while (< i n)\n      (invariant (<= i n) (<= s (* 255 i)))", "(while (<= i n)\n      (invariant (<= i n) (<= s (* 255 i)))")
+    assert any("limites" in p for p in problems(build(src)))
+    try:
+        run(build(src))
+    except RunError as e:
+        assert "fora dos limites" in str(e)
+    else:
+        raise AssertionError("o mesmo bug deveria falhar na execução")
+
+
+def test_missing_length_check_is_caught():
+    src = mutated("    (if (< n 2) (then (return 0)))\n", "")
+    assert any("limites" in p and "load buf 0" in p for p in problems(build(src)))   # n pode ser 0
+
+
+def test_leaking_packet_data_to_output_violates_the_policy():
+    src = mutated("(effects atomic)\n  (stack-budget 256)\n  (pre (<= n 4096))\n  (post (<= result 1))\n  (body\n    (let ok usize",
+                  "(effects atomic syscall)\n  (stack-budget 256)\n  (pre (<= n 4096))\n  (post (<= result 1))\n  (body\n    (do (sys_write 1 pkt n))\n    (let ok usize")
+    ps = problems(build(src))
+    assert any("fluxo proibido net-rx → @write" in p for p in ps), ps
+
+
+def test_forgotten_effect_declaration_is_caught():
+    src = mutated("(effects atomic)\n  (stack-budget 256)", "(effects)\n  (stack-budget 256)")
+    assert any("efeito 'atomic' não declarado" in p for p in problems(build(src)))
+
+
+def test_stack_budget_too_small_is_caught():
+    src = mutated("(stack-budget 256)", "(stack-budget 100)")
+    assert any(p.startswith("pilha: inspect") for p in problems(build(src)))
+
+
+def test_wrong_checksum_breaks_the_loop_invariant():
+    src = mutated("(set s (+ s (cast usize (load buf i))))", "(set s (+ s (* 2 (cast usize (load buf i)))))")
+    assert any("invariante preservada" in p for p in problems(build(src)))
diff --git a/tests/test_run.py b/tests/test_run.py
new file mode 100644
index 0000000..d1a176d
--- /dev/null
+++ b/tests/test_run.py
@@ -0,0 +1,143 @@
+"""Interpretador de referência: executa programas Prova e confere em tempo de execução o que o verificador
+prometeu. Teste diferencial: programas verificados não podem violar nada; programas recusados são pegos."""
+import os, subprocess, sys
+from _util import ROOT, build, example
+from provac.interp import RunError, fuzz_function, run
+
+VERIFIED = ["sum_to", "copy_bytes", "calls", "effects", "regions_flow", "stack_budget", "atomic_counter",
+            "packet_inspector", "driver_demo", "ok_own", "selftest"]
+
+
+def prog(body, statics="", params="", ret="unit", pre="", post=""):
+    return f"{statics}\n(fn f (params {params}) (returns {ret}) (effects syscall atomic) (pre {pre}) (post {post}) (body {body}))"
+
+
+def test_packet_inspector_runs_with_the_expected_result():
+    res, _ = run(build(example("packet_inspector")))
+    assert res.stdout == b"ACCEPT\nDROP\nDROP\n"
+    assert res.exit_code == 1                       # um pacote aceito
+    assert res.statics == {"accepted": 1, "dropped": 2, "last_sum": sum(b"PING hello")}
+
+
+def test_cli_run_prints_output_and_returns_the_program_exit_code():
+    r = subprocess.run([sys.executable, os.path.join(ROOT, "prova.py"), "run",
+                        os.path.join(ROOT, "examples", "packet_inspector.prova")],
+                       capture_output=True, text=True, encoding="utf-8")
+    assert r.stdout == "ACCEPT\nDROP\nDROP\n" and r.returncode == 1
+    assert "interpretador de referência" in r.stderr
+
+
+def test_run_refuses_unverified_programs_unless_forced():
+    path = os.path.join(ROOT, "examples", "bad_inc.prova")
+    cli = lambda *a: subprocess.run([sys.executable, os.path.join(ROOT, "prova.py"), "run", path, "--entry-fn", "inc", *a],
+                                    capture_output=True, text=True, encoding="utf-8")
+    assert cli().returncode == 2 and "não passou na verificação" in cli().stderr
+
+
+def test_runtime_reproduces_the_verifier_counterexamples():
+    inc = build(example("bad_inc"))       # o verificador diz: x = 2**63-1 estoura
+    try:
+        run(inc, "inc", [2**63 - 1])
+    except RunError as e:
+        assert "overflow" in str(e)
+    else:
+        raise AssertionError("o contraexemplo do verificador não reproduziu em tempo de execução")
+    from provac.interp import Slice
+    fill = build(example("bad_bounds"))   # o verificador diz: len = n escreve fora do buffer
+    try:
+        run(fill, "fill", [3, Slice(b"abc"), 3])
+    except RunError as e:
+        assert "fora dos limites" in str(e)
+    else:
+        raise AssertionError("escrita fora dos limites não foi detectada")
+
+
+def test_differential_fuzz_verified_programs_never_violate_anything():
+    total = 0
+    for name in VERIFIED:
+        P = build(example(name))
+        for fn in P.fns:
+            if fn.name == "_start":
+                continue
+            executed, violations = fuzz_function(P, fn.name, runs=120, seed=11)
+            assert executed > 0, f"{name}.{fn.name}: nenhuma entrada satisfez a pre (teste sem poder)"
+            assert not violations, f"{name}.{fn.name}: o verificador aceitou, mas em execução: {violations[:2]}"
+            total += executed
+    assert total > 1000
+
+
+def test_fuzz_finds_the_bugs_in_programs_the_verifier_rejects():
+    for name, fn in (("bad_inc", "inc"), ("bad_bounds", "fill")):
+        executed, violations = fuzz_function(build(example(name)), fn, runs=600, seed=3)
+        assert violations, f"{name}: o fuzzing não achou o bug que o verificador apontou"
+
+
+def test_runtime_checks_contracts_invariants_and_variants():
+    wrong_post = build("(fn f (params (x usize)) (returns usize) (pre (<= x 5)) (post (= result (+ x 1))) (body (return x)))")
+    try:
+        run(wrong_post, "f", [2])
+    except RunError as e:
+        assert "pós-condição de f violada" in str(e)
+    else:
+        raise AssertionError
+    bad_inv = build("(fn f (params) (returns unit) (pre) (post) (body (var i usize 0) "
+                    "(while (< i 5) (invariant (< i 3)) (decreases (- 5 i)) (set i (+ i 1)))))")
+    try:
+        run(bad_inv, "f")
+    except RunError as e:
+        assert "invariante violada" in str(e)
+    else:
+        raise AssertionError
+    bad_var = build("(fn f (params) (returns unit) (pre) (post) (body (var i usize 0) "
+                    "(while (< i 5) (invariant) (decreases 9) (set i (+ i 1)))))")
+    try:
+        run(bad_var, "f")
+    except RunError as e:
+        assert "variante não decresceu" in str(e)
+    else:
+        raise AssertionError
+    pre = build("(fn f (params (x usize)) (returns unit) (pre (<= x 5)) (post) (body))")
+    try:
+        run(pre, "f", [9])
+    except RunError as e:
+        assert "pré-condição de f violada" in str(e)
+    else:
+        raise AssertionError
+
+
+def test_atomic_semantics_at_runtime():
+    cas = build(prog("(return (atomic_cas c 5 9 seq_cst seq_cst))", "(static c (atomic usize) 5)", ret="usize"))
+    r, _ = run(cas, "f")
+    assert r.returned == 5 and r.statics["c"] == 9                  # casou: troca e devolve o antigo
+    cas2 = build(prog("(return (atomic_cas c 5 9 seq_cst seq_cst))", "(static c (atomic usize) 7)", ret="usize"))
+    r, _ = run(cas2, "f")
+    assert r.returned == 7 and r.statics["c"] == 7                  # não casou: não troca
+    wrap = build(prog("(return (atomic_fetch_add c 1 relaxed))", "(static c (atomic usize) 18446744073709551615)", ret="usize"))
+    r, _ = run(wrap, "f")
+    assert r.returned == 2**64 - 1 and r.statics["c"] == 0          # dá a volta (wrap) por definição
+
+
+def test_syscall_semantics_at_runtime():
+    P = build('(data m "hi")\n' + "(fn f (params) (returns i64) (effects syscall) (pre) (post) "
+              "(body (let_slice b (data-ref m)) (do (sys_write 2 b (len b))) (return (sys_write 7 b (len b)))))")
+    r, _ = run(P, "f")
+    assert r.stderr == b"hi" and r.stdout == b"" and r.returned == -9   # fd 2 -> stderr; fd inválido -> EBADF
+
+
+def test_out_of_fuel_is_inconclusive_not_a_violation():
+    # regressão: o limite era contado como VIOLAÇÃO (falso positivo) e o fuzzing de gcd com entradas grandes travava.
+    # Dois caminhos de combustível: limite de ITERAÇÕES do laço (gcd: poucas instruções por volta) e limite de
+    # PASSOS (sort: muitas instruções por volta). Os dois precisam ser inconclusivos.
+    from provac.interp import Inconclusive, Machine, RunError, Slice
+    P = build(example("selftest"))
+    data = bytes((i * 7) % 256 for i in range(300))
+    for name, args in (("gcd", [1000, 1]), ("sort", [len(data), Slice(data)])):
+        try:
+            Machine(P, check=True, fuel=50).call(name, args)
+        except Inconclusive:
+            pass
+        else:
+            raise AssertionError(f"{name} deveria esgotar o combustível")
+    assert issubclass(Inconclusive, RunError)
+    executed, violations = fuzz_function(P, "gcd", runs=120, seed=3)
+    assert executed > 0 and not violations, violations[:2]
diff --git a/tests/test_selftest.py b/tests/test_selftest.py
new file mode 100644
index 0000000..d38b255
--- /dev/null
+++ b/tests/test_selftest.py
@@ -0,0 +1,119 @@
+"""examples/selftest.prova: programa de TESTE escrito em Prova.
+Estaticamente: tudo provado (segurança de memória, ausência de overflow, terminação, contratos, política de fluxo).
+Dinamicamente: roda os casos e imprime PASS/FAIL. A CORREÇÃO FUNCIONAL de sort/reverse/gcd/... (que contratos ainda não
+expressam, pois o conteúdo de fatias não é modelado) é conferida aqui, executando contra o Python."""
+import math, random
+from _util import build, example, pending, problems
+from provac.interp import Slice, fuzz_function, run
+from provac.mlir import emit_module
+
+P = build(example("selftest"))
+
+
+def mutate(src, fn, old, new):
+    """Troca `old` por `new` SÓ dentro de (fn <fn> ...). Se o padrão não existir ali, o teste falha dizendo qual
+    (um replace global pegaria a primeira ocorrência de outra função: o teste ficaria acoplado à ordem do arquivo)."""
+    head, sep, rest = src.partition(f"(fn {fn}\n")
+    assert sep, f"função {fn} não encontrada em selftest.prova"
+    body, nxt, tail = rest.partition("\n(fn ")
+    assert old in body, f"padrão {old!r} não encontrado em (fn {fn}): atualize o teste junto com o exemplo"
+    return head + sep + body.replace(old, new, 1) + nxt + tail
+
+
+def call(prog, name, *args):
+    res, _ = run(prog, name, list(args))
+    return res.returned
+
+
+def sorted_by_prova(prog, data):
+    s = Slice(data)
+    run(prog, "sort", [len(data), s])
+    return bytes(s.data)
+
+
+def reversed_by_prova(prog, data):
+    s = Slice(data)
+    run(prog, "reverse", [len(data), s])
+    return bytes(s.data)
+
+
+def inputs(seed, count=300, max_len=40):
+    rnd = random.Random(seed)
+    yield b""
+    yield b"\x00"
+    yield bytes(range(255, 245, -1))          # decrescente
+    yield bytes([7] * 9)                      # todos iguais
+    for _ in range(count):
+        yield bytes(rnd.randrange(256) for _ in range(rnd.randrange(max_len + 1)))
+
+
+def test_selftest_is_fully_proved_with_nothing_merely_tested():
+    assert not problems(P) and not pending(P)
+    assert sum(len(r["obligations"]) for r in P.results) > 150
+
+
+def test_selftest_runs_and_prints_pass():
+    res, _ = run(P)
+    assert res.stdout == b"PASS\n" and res.exit_code == 0
+
+
+def test_a_wrong_case_is_caught_at_runtime_but_not_by_the_verifier():
+    wrong = mutate(example("selftest"), "_start", "(call sum_bytes (len s) s) 1129)", "(call sum_bytes (len s) s) 1130)")
+    Q = build(wrong)
+    assert not problems(Q), "o conteúdo de `sample` não é modelado: o verificador não pode saber que 1130 está errado"
+    res, _ = run(Q)
+    assert res.stdout == b"FAIL\n" and res.exit_code == 1
+
+
+def test_sort_matches_python_sorted():
+    for data in inputs(1):
+        assert sorted_by_prova(P, data) == bytes(sorted(data)), data
+
+
+def test_reverse_matches_python():
+    for data in inputs(2):
+        assert reversed_by_prova(P, data) == data[::-1], data
+
+
+def test_gcd_matches_math_gcd():
+    rnd = random.Random(3)
+    for _ in range(300):
+        a, b = rnd.randrange(1, 400), rnd.randrange(1, 400)
+        assert call(P, "gcd", a, b) == math.gcd(a, b), (a, b)
+
+
+def test_sum_count_max_match_python():
+    for data in inputs(4, max_len=60):
+        n = len(data)
+        assert call(P, "sum_bytes", n, Slice(data)) == sum(data)
+        for v in (0, 111, 255):
+            assert call(P, "count_byte", n, Slice(data), v) == data.count(v)
+        if n:
+            assert call(P, "max_byte", n, Slice(data)) == max(data)
+
+
+def test_no_runtime_violation_in_any_function_of_the_program():
+    for fn in P.fns:
+        if fn.name != "_start":
+            executed, violations = fuzz_function(P, fn.name, runs=150, seed=5)
+            assert executed > 0 and not violations, (fn.name, violations[:2])
+
+
+def test_functional_tests_have_teeth():
+    # uma ordenação ao contrário é SEGURA (o verificador aceita) mas errada: só a execução denuncia
+    bad = mutate(example("selftest"), "sort", "(if (> x y)", "(if (< x y)")
+    Q = build(bad)
+    assert not problems(Q)
+    assert any(sorted_by_prova(Q, d) != bytes(sorted(d)) for d in inputs(1, count=50)), "teste sem poder"
+    # e uma reversão que para cedo
+    bad2 = mutate(example("selftest"), "reverse", "(while (< (+ lo 1) hi)", "(while (< (+ lo 2) hi)")
+    Q2 = build(bad2)
+    assert not problems(Q2)
+    assert any(reversed_by_prova(Q2, d) != d[::-1] for d in inputs(2, count=50)), "teste sem poder"
+
+
+def test_selftest_emits_for_every_target():
+    for t in ("x86_64", "aarch64", "riscv64"):
+        text = emit_module(P.compiled, P.data, t)
+        for needle in ("func.func @sort", "func.func @gcd", "arith.cmpi ult", "llvm.inline_asm"):
+            assert needle in text, (t, needle)
