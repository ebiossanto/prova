;; DEVE FALHAR: zero_fill espera uma fatia de comprimento n, mas passo n = 5 com buf de comprimento m.
(fn zero_fill
  (params (n usize) (buf (slice u8 n)))
  (returns unit)
  (pre)
  (post)
  (body (return)))

(fn caller
  (params (m usize) (buf (slice u8 m)))
  (returns unit)
  (pre)
  (post)
  (body (do (call zero_fill 5 buf))))
