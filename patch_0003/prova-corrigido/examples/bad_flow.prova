;; DEVE FALHAR: o pacote de net-rx é copiado para kmem e kmem vai para a saída: net-rx → kmem → @write,
;; violando (deny-flow net-rx @write) mesmo sem nenhum fluxo direto.
(region net-rx)
(region kmem)
(deny-flow net-rx @write)

(fn copy_packet
  (params (n usize) (src (slice u8 n net-rx))
          (m usize) (dst (slice u8 m kmem))
          (len usize))
  (returns unit)
  (effects)
  (pre (<= len n) (<= len m))
  (post)
  (body
    (var i usize 0)
    (while (< i len)
      (invariant (<= i len))
      (decreases (- len i))
      (store dst i (load src i))
      (set i (+ i 1)))))

(fn leak
  (params (n usize) (pkt (slice u8 n net-rx)) (buf (slice u8 n kmem)))
  (returns unit)
  (effects syscall)
  (pre)
  (post)
  (body
    (do (call copy_packet n pkt n buf n))
    (do (sys_write 1 buf n))))
