;; DEVE FALHAR: mid chama leaf; o pior caso (32 + 24 = 56 bytes no modelo) excede o orçamento de 40.
(fn leaf
  (params (x usize))
  (returns usize)
  (effects)
  (pre (<= x 100))
  (post (= result (+ x 1)))
  (body (return (+ x 1))))

(fn mid
  (params (x usize))
  (returns usize)
  (effects)
  (stack-budget 40)
  (pre (<= x 100))
  (post (<= result 101))
  (body
    (let y usize (call leaf x))
    (return y)))
