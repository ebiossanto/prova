;; Prova: _start para Linux RISC-V (freestanding, sem libc).
;; write(1, msg, len) e depois exit(0). O compilador traduz sys_write/sys_exit para o número da
;; syscall e os registradores de cada arquitetura (a7=64/93; a0,a1,a2); o programa NÃO conhece esses números.
;; O fd é sempre 1 (saída padrão); (len b) evita errar a contagem de bytes.

(data msg "Hello from Prova RISC-V!\n")

(fn _start
  (params)
  (returns unit)
  (effects syscall)
  (pre)
  (post)
  (body
    (let_slice b (data-ref msg))
    (do (sys_write 1 b (len b)))
    (sys_exit 0)))
