;; Prova: _start para RISC-V (freestanding, sem libc)
;; Ponto de entrada: escreve "Hello from Prova RISC-V!" via syscall write(64, buf, n)
;; então encerra via syscall exit(93)
;; Arquitetura: ecall, a7 = número da syscall, a0-a5 = argumentos

(data msg "Hello from Prova RISC-V!\n")

(fn _start
  (params)
  (returns unit)
  (pre)
  (post)
  (body
    (let_slice b (data-ref msg))
    (do (sys_write 64 b 25))
    (sys_exit 93)))