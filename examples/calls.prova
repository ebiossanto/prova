;; Verificação modular: a pre de clamp vira obrigação em double_clamped; a post de clamp vira hipótese.
(fn clamp
  (params (x i64) (lo i64) (hi i64))
  (returns i64)
  (pre (<= lo hi))
  (post (<= lo result) (<= result hi))
  (body
    (if (< x lo) (then (return lo)))
    (if (> x hi) (then (return hi)))
    (return x)))

(fn double_clamped
  (params (x i64))
  (returns i64)
  (pre)
  (post (<= 0 result) (<= result 2000))
  (body
    (let c i64 (call clamp x 0 1000))
    (return (* c 2))))

;; Tipo dependente: (slice u8 n) exige que o comprimento passado seja exatamente n.
(fn zero_fill
  (params (n usize) (buf (slice u8 n)))
  (returns unit)
  (pre)
  (post)
  (body
    (var i usize 0)
    (while (< i n)
      (invariant (<= i n))
      (decreases (- n i))
      (store buf i 0)
      (set i (+ i 1)))))

;; Empresta buf a zero_fill e depois o consome: posse linear + chamada.
(fn wipe
  (params (n usize) (buf (own (slice u8 n))))
  (returns unit)
  (pre)
  (post)
  (body
    (do (call zero_fill n buf))
    (drop buf)))
