;; DEVE FALHAR: sink consome buf (own); usar buf depois é uso após movimento.
(fn sink
  (params (n usize) (b (own (slice u8 n))))
  (returns unit)
  (pre)
  (post)
  (body (drop b)))

(fn caller
  (params (n usize) (buf (own (slice u8 n))))
  (returns unit)
  (pre (< 0 n))
  (post)
  (body
    (do (call sink n buf))
    (store buf 0 1)))
