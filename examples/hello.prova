;; Freestanding: sem libc. _start escreve na saída padrão e encerra via syscall.
;; O mesmo fonte vira x86-64, AArch64 e RISC-V; o compilador escolhe registradores e números.
(data msg "Hello, Prova!\n")

(fn _start
  (params)
  (returns unit)
  (effects syscall)
  (pre)
  (post)
  (body
    (let_slice b (data-ref msg))
    (do (sys_write 1 b (len b)))
    (sys_exit 0)))
