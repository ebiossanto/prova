;; Copia len bytes. Provado: todo load/store dentro dos limites, sem overflow em i,
;; e correção funcional: ao final, para todo k em [0, len), dst[k] = src[k].
(fn copy_bytes
  (params (n usize) (dst (slice u8 n))
          (m usize) (src (slice u8 m))
          (len usize))
  (returns unit)
  (pre (<= len n) (<= len m))
  (post (forall k 0 len (= (load dst k) (load src k))))
  (body
    (var i usize 0)
    (while (< i len)
      (invariant (<= i len) (forall k 0 i (= (load dst k) (load src k))))
      (decreases (- len i))
      (store dst i (load src i))
      (set i (+ i 1)))))
