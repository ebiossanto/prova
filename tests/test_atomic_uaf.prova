;; DEVE FALHAR: Use-after-free linear — uso de fatia (own ...) após (drop buf)
;; (Em Prova, células atômicas só existem em (static ...) globais e nunca em escopo local;
;;  memória local/transferida usa posse linear (own ...) e qualquer acesso após drop/movimento é bloqueado.)
(fn uaf_after_drop
  (params (n usize) (buf (own (slice u8 n))))
  (returns u8)
  (pre (< 0 n))
  (post)
  (body
    (drop buf)
    (return (load buf 0))))
